{
  "name": "exwebsite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "service:start": "node scripts/runtime/entry.mjs service:start",
    "service:stop": "node scripts/runtime/entry.mjs service:stop",
    "service:status": "node scripts/runtime/entry.mjs service:status",
    "service:logs": "node scripts/runtime/entry.mjs service:logs",
    "dev": "node scripts/runtime/entry.mjs dev",
    "infra": "node scripts/runtime/entry.mjs infra",
    "api:lint": "redocly lint api/openapi.yaml",
    "api:generate": "node scripts/api/generate.mjs generate",
    "typecheck": "pnpm --filter @workspace/sdk build && pnpm -r typecheck && pnpm exec tsc --noEmit -p tests/api-client/tsconfig.json && pnpm exec tsc --noEmit -p tests/server-types/tsconfig.json",
    "test": "node scripts/runtime/tests.mjs",
    "test:watch": "node scripts/runtime/tests.mjs --watch",
    "build": "node scripts/runtime/build.mjs",
    "start": "node scripts/runtime/entry.mjs start",
    "stop": "node scripts/runtime/entry.mjs stop",
    "logs": "node scripts/runtime/entry.mjs logs",
    "db:migrate": "pnpm --filter @workspace/server db:migrate",
    "db:reset": "pnpm --filter @workspace/server db:reset",
    "db:registration-inventory": "pnpm --filter @workspace/server db:registration-inventory",
    "api:bundle": "node scripts/api/generate.mjs bundle",
    "api:check": "node scripts/api/generate.mjs check"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.2",
    "@testcontainers/postgresql": "^11.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/pg": "^8.15.2",
    "@workspace/common": "workspace:*",
    "@workspace/server": "workspace:*",
    "ajv": "^8.20.0",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.16.3",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
