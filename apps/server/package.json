{
  "name": "@workspace/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "support-feedback": "node ../../scripts/runtime/server.mjs support-feedback",
    "dev": "node ../../scripts/runtime/server.mjs dev",
    "start": "node ../../scripts/runtime/server.mjs start",
    "build": "node ../../scripts/api/generate.mjs generate && node ../../scripts/clean-server-build.mjs && tsc -p tsconfig.json && node ../../scripts/rewrite-server-imports.mjs && node ../../scripts/copy-support-fields.mjs",
    "typecheck": "node ../../scripts/api/generate.mjs check && tsc --noEmit -p tsconfig.json",
    "db:migrate": "node ../../scripts/runtime/server.mjs db:migrate",
    "db:reset": "node ../../scripts/runtime/server.mjs db:reset",
    "db:registration-inventory": "node ../../scripts/runtime/server.mjs db:registration-inventory",
    "db:generate": "drizzle-kit generate",
    "sso:create": "node ../../scripts/runtime/server.mjs sso:create",
    "sso:inspect": "node ../../scripts/runtime/server.mjs sso:inspect",
    "auth:disable": "node ../../scripts/runtime/server.mjs auth:disable",
    "auth:enable": "node ../../scripts/runtime/server.mjs auth:enable",
    "integration:check": "node ../../scripts/runtime/server.mjs integration:check"
  },
  "dependencies": {
    "@fastify/autoload": "6.5.1",
    "@fastify/multipart": "10.1.2",
    "@workspace/api-client": "workspace:*",
    "@workspace/common": "workspace:*",
    "ajv": "8.20.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.11.4",
    "fastify-plugin": "6.0.0",
    "pg": "^8.16.3",
    "qcloud-cos-sts": "^3.1.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "^0.35.4",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.15.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
